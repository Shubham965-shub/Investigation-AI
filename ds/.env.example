

# .env template — Secrets and environment-specific configuration
# Copy this file to .env at the repository root and fill in your values.
# Never commit .env to version control.
#
# Schema and structural config (tables, columns, search limits) live in config/config.yaml

# ── Database (credentials + environment) ─────────────────────
DB_HOST=host
DB_NAME=db_name
DB_USER=user
DB_PASSWORD=password
DB_PORT=1234
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=20

# ── OpenAI (secret) ─────────────────────────────────────────
# OPENAI_API_KEY=your_openai_api_key_here

# ── Server (environment-specific) ────────────────────────────
SEARCH_AGENT_HOST=0.0.0.0
SEARCH_AGENT_PORT=8001
