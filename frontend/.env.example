# Copy to .env and fill in. frontend/.env is NOT committed (it holds real
# tokens); this example is the template of every key the build understands.

VITE_API_BASE_URL=http://localhost:8000/api

# GitHub PAT with read:packages — required by npm ci to install private
# @strides-pharma-science-ltd packages (feedback-widget) from GitHub Packages.
# Consumed by deploy/qa.sh and CI; for manual npm ci, export it in your shell
# with a matching //npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN} npmrc line.
NODE_AUTH_TOKEN=ghp_your-token-here

# PostHog (client-side analytics — project token ships in the public bundle)
VITE_POSTHOG_PROJECT_TOKEN=phc_your-project-token
VITE_POSTHOG_HOST=https://posthog.strideslighthouse.com

# Deployed QA feedback service (feedback-platform repo) — consumed by the
# frontend widget at build time.
VITE_FEEDBACK_API_BASE_URL=https://feedback-service.graysand-fe5571c1.centralindia.azurecontainerapps.io/api/v1
