# Copy this file to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars to version control.

# ── Azure ────────────────────────────────────────────────────
subscription_id     = "your-azure-subscription-id"
resource_group_name = "rg-investigationai-ds"
location            = "centralindia"

# ── Existing ACR ─────────────────────────────────────────────
acr_name                = "your-acr-name"
acr_resource_group_name = "your-acr-resource-group"

# ── Container App ────────────────────────────────────────────
container_app_name     = "investigationai-search-agent"
container_app_env_name = "investigationai-ds-env"
image_tag              = "latest"
cpu                    = 0.5
memory                 = "1Gi"
min_replicas           = 0
max_replicas           = 3

# ── Database secrets ─────────────────────────────────────────
db_host          = "your-db-host.postgres.database.azure.com"
db_name          = "investigation_ai"
db_user          = "your-db-user"
db_password      = "your-db-password"
db_port          = "5432"
db_pool_min_size = "1"
db_pool_max_size = "20"

# ── OpenAI ───────────────────────────────────────────────────
openai_api_key = "sk-your-openai-api-key"
