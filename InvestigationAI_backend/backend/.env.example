# Copy to .env and adjust for your environment. Never commit .env.

# ── Server ────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Upstream InvestigationAi_DS service ─────────────────────────
DS_SERVICE_BASE_URL=http://localhost:8001
DS_SERVICE_TIMEOUT_SECONDS=60

# ── CORS (comma-separated origins allowed to call this API) ────
CORS_ORIGINS=http://localhost:5173

# ── Auth placeholder (replace with real auth later) ─────────────
AUTH_PLACEHOLDER_SECRET=dev-placeholder-secret-change-me

# ── Database — same shared Postgres instance InvestigationAi_DS uses ───
DB_HOST=host
DB_PORT=5432
DB_NAME=db_name
DB_USER=user
DB_PASSWORD=password
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
# Alternative to the DB_* fields above: a full connection string, e.g.
# postgresql://user:password@host:5432/dbname — takes precedence if set.
# DATABASE_URL_OVERRIDE=
