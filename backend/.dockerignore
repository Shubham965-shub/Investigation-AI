# Secrets — supplied at runtime via environment/env_file, never baked into the image
**/.env
**/.env.*
!**/.env.example

# Python
**/.venv
**/venv
**/__pycache__
**/*.pyc
**/*.egg-info
**/.pytest_cache

# VCS / editor
.git
.gitignore
**/.DS_Store
.vscode
.idea

# Frontend/ds trees (unused in the backend build context, harmless if present)
**/node_modules
**/dist
